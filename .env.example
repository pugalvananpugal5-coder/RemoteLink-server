# Copy this file to .env and fill in real values. Never commit .env.

# Port the HTTP + WebSocket server listens on
PORT=8443

# Comma-separated list of allowed origins for the health-check REST endpoint.
# WebSocket connections are authenticated by device ID + session token instead
# of Origin, since native Android clients don't send a browser Origin header.
ALLOWED_ORIGINS=https://yourdomain.com

# Secret used to HMAC-sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SECRET=replace-with-a-real-64-char-hex-secret

# How long a connection-request approval token is valid before it expires
# if the two devices never establish a WebRTC connection (seconds)
PENDING_SESSION_TTL_SECONDS=60

# Absolute maximum lifetime of an established remote-support session (seconds)
# After this, the server force-terminates the session and both clients must
# re-request/re-approve. Prevents indefinite unattended access by default.
MAX_SESSION_DURATION_SECONDS=7200

# Rate limiting: max connection requests a single device may send per window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# TURN server credentials (see docs/turn-setup.md). Required for NAT traversal
# fallback when direct P2P WebRTC fails (e.g. two devices on carrier-grade NAT).
TURN_URL=turns:your-turn-server.example.com:5349
TURN_USERNAME=replace-me
TURN_CREDENTIAL=replace-me

# STUN is free/public and doesn't need credentials, but is listed here so it's
# configurable per deployment.
STUN_URL=stun:stun.l.google.com:19302
